[Unit]
Description=Ucak bileti takip botu (IST -> BKK/HKT)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/flightbot
ExecStart=/usr/bin/node /opt/flightbot/bot.js
Restart=always
RestartSec=30
StandardOutput=journal
StandardError=journal
Environment=NODE_ENV=production
# Webhook'u config.json yerine burada tutmak istersen:
# Environment=DISCORD_WEBHOOK=https://discord.com/api/webhooks/...

[Install]
WantedBy=multi-user.target
